# Ray + Python base image tag.
# Constraint 1: the tag must match the host's Ray/Python version exactly,
#               down to the patch (protocol §2).
# Constraint 2: the registry must be explicit (docker.io/...). Podman does
#               not assume Docker Hub for unqualified names, and on hosts
#               whose /etc/containers/registries.conf defines no
#               unqualified-search-registries a short name fails to resolve.
RAY_BASE_TAG=docker.io/rayproject/ray:2.57.0-py311-gpu

# Baked asset sizes (in megabytes). Single-sourced: build_images.sh passes these as build args.
WEIGHTS_MB=8
PAYLOAD_MB=64

# Ray cluster
RAY_CLUSTER_ADDRESS=http://localhost:8265

# Podman
CONTAINER_RUNTIME=podman

# Readiness wait for the step verify scripts (D25).
# The step1/step2 verification scripts poll `serve status` until the
# deployments report RUNNING. The budget and poll interval below let a
# slower or faster host adjust without editing code.
#
# SPIKE_READINESS_TIMEOUT_S: total wait budget in seconds (default 300).
#   The fixture images are ~14GB (torch) and ~19GB (tf); podman must
#   start a container per replica and the first start is slow, so the
#   old hard-coded 60s was not enough. Raise on slower hosts.
SPIKE_READINESS_TIMEOUT_S=300
# SPIKE_READINESS_POLL_S: seconds between status polls (default 5).
SPIKE_READINESS_POLL_S=5

# ── Step 3 gate knobs (D29/D30/D31, D35) ─────────────────────────
# SPIKE_DOWNSCALE_WAIT_S: total budget (seconds) for the gate to wait
#   for Ray to scale tool_torch to zero before taking the post-idle
#   VRAM snapshot (default 240). D35: the old fixed sleep of
#   SPIKE_DOWNSCALE_DELAY_S + SPIKE_DOWNSCALE_BUFFER_S (65s) measured
#   BEFORE Ray's own timer could expire — the autoscaler starts the
#   downscale clock only after the request rate decays over
#   look_back_period_s (15s), so the earliest release is ~75-80s and
#   the 65s sleep produced a false "VRAM not released" (ledger §9M).
#   The gate now polls target_num_replicas; the budget is a safety
#   net well above look_back_period_s + downscale_to_zero_delay_s.
#   Raise on slower hosts. (SPIKE_DOWNSCALE_DELAY_S and
#   SPIKE_DOWNSCALE_BUFFER_S are removed: with state-based polling
#   they no longer control anything.)
SPIKE_DOWNSCALE_WAIT_S=240
# SPIKE_VRAM_RELEASE_TOLERANCE_MB: MiB still occupied after idle that is
#   tolerated as driver noise (default 256; the fixture allocates 4096).
SPIKE_VRAM_RELEASE_TOLERANCE_MB=256
# SPIKE_GPU_INDEX: pin the GPU the gate measures, for hosts where the
#   per-replica cuda_visible_devices attribution is not trustworthy
#   (default: unset — measure the GPU each replica reports).
# SPIKE_GPU_INDEX=
# SPIKE_RAY_NUM_GPUS: GPUs the cluster registers for EVERY step
#   (default 1). Pinned at 1 so the step 3 tools are forced onto the
#   same GPU — contention is structural; the launcher prints the
#   resolved count. Set 0 deliberately only for steps 1/2 on a host
#   whose GPUs are all occupied.
SPIKE_RAY_NUM_GPUS=1

# ── Step 5/6 knobs (D29) ────────────────────────────────────────
# SPIKE_STEP5_MAX_ERRORS: failed alternations tolerated before step 5
#   records a negative finding (default 0 — a single failure fails).
SPIKE_STEP5_MAX_ERRORS=0
# SPIKE_RECOVERY_TIMEOUT_S: wait budget for step 6's recovery polls
#   (default 120; poll interval is SPIKE_READINESS_POLL_S).
SPIKE_RECOVERY_TIMEOUT_S=120

# ── Step 4/6 config knobs (D38) ─────────────────────────────────
# SPIKE_STEP4_CONFIG: the Serve config step 4 deploys before its
#   payload reads (default apps/step3_config_container.yaml — the
#   container-key step 3 variant, whose tool_torch holds a GPU and
#   bakes the same /opt/spike/data payload this step reads).
# SPIKE_STEP4_CONFIG=apps/step3_config_container.yaml
# SPIKE_STEP6_CONFIG: the Serve config step 6 re-deploys on its
#   head-node-kill recovery path (default apps/step6_config.yaml —
#   the same config the step is started with; the old hard-coded
#   apps/step3_config.yaml was the image_uri config, whose replicas
#   hold no GPU).
# SPIKE_STEP6_CONFIG=apps/step6_config.yaml
