# Ray + Python base image tag (must match host exactly, down to patch)
RAY_BASE_TAG=rayproject/ray:2.57.0-py311-gpu

# Baked asset sizes (in megabytes). Single-sourced: build_images.sh passes these as build args.
WEIGHTS_MB=8
PAYLOAD_MB=64

# Ray cluster
RAY_CLUSTER_ADDRESS=http://localhost:8265

# Podman
CONTAINER_RUNTIME=podman
